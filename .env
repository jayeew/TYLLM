APP_NAME=inventory-forecast-demo
# DATABASE_URL=postgresql+psycopg://postgres:postgres@123:5433/inventory_forecast_demo
API_PREFIX=/api/v1
ALERT_CORRECTION_FACTOR=1

# 新品期（≤30天）
ALERT_FACTOR_K0_PHASE1 = 1.5
# 成熟期（30~180天）
ALERT_FACTOR_K0_PHASE2 = 1.0
# 衰退期（＞180天）
ALERT_FACTOR_K0_PHASE3 = 0.6

# 工作日（非旺季）
ALERT_FACTOR_K1_WORKDAY = 1.0
# 周末
ALERT_FACTOR_K1_WEEKEND = 1.3
# 法定节假日
ALERT_FACTOR_K1_HOLIDAY = 2.2
# 季节高峰
ALERT_FACTOR_K1_PEAK = 1.8
# 维度权重
WEIGHT_K1 = 0.65

# 客流下降
ALERT_FACTOR_K2_DOWN = 0.7
# 客流平稳
ALERT_FACTOR_K2_STABLE = 1.0
# 客流上升
ALERT_FACTOR_K2_UP = 1.4
# 客流激增
ALERT_FACTOR_K2_FASTUP = 2.0 
# 维度权重
WEIGHT_K2 = 0.35

POSTGRES_RECORDMANAGER_HOST=127.0.0.1
POSTGRES_RECORDMANAGER_PORT=5433
POSTGRES_RECORDMANAGER_DATABASE=inventory_forecast_demo
POSTGRES_RECORDMANAGER_USER=postgres
POSTGRES_RECORDMANAGER_PASSWORD=123
